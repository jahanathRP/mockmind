# Secret key for session security (generate a secure random string for production)
SECRET_KEY=generate_a_secure_random_string_for_production

# Optional: Port to bind (defaults to 5000)
PORT=5000

# Optional: Database URL (defaults to SQLite: database/database.db)
# Example PostgreSQL: postgresql://username:password@hostname:5432/dbname
# DATABASE_URL=postgresql://user:pass@host:5432/mockmind

# Optional: Google Gemini API Key for enhanced AI feedback
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Flask Debug Mode (Set to False in production)
FLASK_DEBUG=False
